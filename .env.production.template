# 生产环境模板（全部用占位符；通过密钥管理注入，禁止提交真实值）
ENV=prod

# --- PostgreSQL ---
POSTGRES_PASSWORD=<REDACTED_STRONG_PASSWORD>

# --- User Service JWT/管理员初始化（生产必填且强随机） ---
JWT_SECRET=<REDACTED_STRONG_RANDOM_32B+>
JWT_ISSUER=quantbull-prod
JWT_AUDIENCE=quantbull-api
ADMIN_USERNAME=<REDACTED_ADMIN_USERNAME>
ADMIN_PASSWORD=<REDACTED_STRONG_PASSWORD>

# --- CORS（JSON 数组；生产必须收敛到你的前端域名） ---
CORS_ALLOW_ORIGINS=["https://app.example.com"]
CORS_ALLOW_CREDENTIALS=true

# --- 网关可信代理（部署在反代/LB 后面时必配） ---
TRUSTED_PROXIES=["10.0.0.10"]

# --- Cookie/CSRF（生产强制 HTTPS） ---
AUTH_COOKIE_NAME=quantbull_access
CSRF_COOKIE_NAME=quantbull_csrf
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=app.example.com

# --- Third-party ---
TUSHARE_TOKEN=<REDACTED_TUSHARE_TOKEN>

# --- AI Hub (LLM keys, required in prod) ---
DEEPSEEK_API_KEY=<REDACTED_DEEPSEEK_API_KEY>
QWEN_API_KEY=<REDACTED_QWEN_API_KEY>
OPENAI_API_KEY=<REDACTED_OPENAI_API_KEY>

# Daily report DB password (if used)
DAILY_REPORT_DB_PASSWORD=<REDACTED_STRONG_PASSWORD>
