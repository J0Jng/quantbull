# 基础环境
ENV=local

# 安全密钥（生产必须更换）
JWT_SECRET=change-me-in-prod
JWT_ISSUER=quantbull
JWT_AUDIENCE=quantbull-api
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# CORS
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true

# 网关可信代理
TRUSTED_PROXIES=["127.0.0.1"]

# Cookie 与 CSRF
AUTH_COOKIE_NAME=quantbull_access
CSRF_COOKIE_NAME=quantbull_csrf
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=

# 数据库/第三方
POSTGRES_PASSWORD=change-me
DAILY_REPORT_DB_PASSWORD=change-me
# 第三方 Token（生产必须通过密钥管理注入，禁止写入仓库）
TUSHARE_TOKEN=<REDACTED_TUSHARE_TOKEN>

# AI Hub（LLM keys；生产必须通过密钥管理注入，禁止写入仓库）
DEEPSEEK_API_KEY=change-me
QWEN_API_KEY=change-me
OPENAI_API_KEY=change-me
