# QuantBull deployment env template
# Copy to .env and replace all placeholder values.

# Environment: local | prod
ENV=prod

# Postgres (required)
POSTGRES_USER=quantbull
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=quantbull_db

# Daily Report DB role password (required; used by Postgres init script)
DAILY_REPORT_DB_PASSWORD=CHANGE_ME_DAILY_REPORT_PASSWORD

# API Gateway / User Service security (required in ENV!=local)
JWT_SECRET=CHANGE_ME_STRONG_RANDOM_32B+
JWT_ISSUER=quantbull
JWT_AUDIENCE=quantbull-api
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# CORS / cookies (required in ENV!=local)
# JSON array string, e.g. ["https://app.example.com"]
CORS_ALLOW_ORIGINS=["https://app.example.com"]
CORS_ALLOW_CREDENTIALS=true

# Reverse-proxy IP allowlist for trusting X-Forwarded-For (JSON array string)
# Example when Nginx is on the same host: ["172.17.0.1"] (check your docker bridge gateway)
TRUSTED_PROXIES=[]

AUTH_COOKIE_NAME=quantbull_access
CSRF_COOKIE_NAME=quantbull_csrf
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=

# Data Service (recommended)
TUSHARE_TOKEN=

# AI Hub (required in ENV!=local)
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OPENAI_API_KEY=

# Optional model routing (defaults exist)
DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_MODEL=deepseek-chat
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo
DEFAULT_MODEL=deepseek
DEFAULT_MODEL_FOR_NEWS=deepseek
DEFAULT_MODEL_FOR_SUMMARY=qwen
DEFAULT_MODEL_FOR_STRATEGY=deepseek

# TDengine / Redis optional secrets (only needed if you enable auth)
TDENGINE_PASSWORD=
REDIS_PASSWORD=
