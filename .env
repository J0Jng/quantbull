# Local/dev env (auto-created to fix missing DB password)
# Change these values before production use.
ENV=dev

# Postgres (used by docker-compose)
POSTGRES_USER=quant
POSTGRES_PASSWORD=quantpass
POSTGRES_DB=quantbull_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DAILY_REPORT_DB_PASSWORD=change_me_daily_report

# Auth / security
# --- User Service JWT/管理员初始化（生产必填且强随机） ---
JWT_SECRET=change_me
JWT_ISSUER=quantbull
JWT_AUDIENCE=quantbull
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# CORS / cookies
# --- CORS（JSON 数组；生产必须收敛到你的前端域名） ---
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
AUTH_COOKIE_NAME=qb_auth
CSRF_COOKIE_NAME=quantbull_csrf
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# 网关可信代理
TRUSTED_PROXIES=["127.0.0.1"]

# External services
TUSHARE_TOKEN=ced0595b8c1603011a2fd4bee5e8cca551ce661fdf779a7bda47e66c
DEEPSEEK_API_KEY=sk-d0a22a6a95534cb4b168e2e8e020d1fd
QWEN_API_KEY=sk-d0a22a6a95534cb4b168e2e8e020d1fd
OPENAI_API_KEY=sk-d0a22a6a95534cb4b168e2e8e020d1fd

# Database
DATABASE_URL=postgresql+asyncpg://quantbull:change_me@postgres:5432/quantbull_db
SYNC_DATABASE_URL=postgresql+psycopg2://quantbull:change_me@postgres:5432/quantbull_db

# --- Cookie/CSRF（生产强制 HTTPS） ---
AUTH_COOKIE_NAME=quantbull_access
CSRF_COOKIE_NAME=quantbull_csrf
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=app.example.com

LOG_LEVEL=INFO