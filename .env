# Local/dev env (docker-compose uses this file for variable substitution)
# 建议保持 ENV=local，这样各微服务会走更宽松的本地校验逻辑。
ENV=local
LOG_LEVEL=INFO

# PostgreSQL（与 docker-compose 一致）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=quantbull
POSTGRES_PASSWORD=quantpass
POSTGRES_DB=quantbull_db

# daily-report 初始化脚本当前使用固定口令（见 docker/postgres/init/daily_report_init.sql）
DAILY_REPORT_DB_PASSWORD=change_me_daily_report

# Auth / security（本地默认值；生产请替换为强随机）
JWT_SECRET=change_me
JWT_ISSUER=quantbull
JWT_AUDIENCE=quantbull
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# CORS / cookies（本地开发默认）
# CORS_ALLOW_ORIGINS 必须是 JSON 数组字符串
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
AUTH_COOKIE_NAME=quantbull_access
CSRF_COOKIE_NAME=quantbull_csrf
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=
TRUSTED_PROXIES=["127.0.0.1"]

# Redis（给需要 host/port 形式的服务使用；REDIS_URL 仍由 docker-compose 显式注入）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# TDengine（quant-engine 使用 REST 查询时需要 user/password/REST 配置）
TDENGINE_HOST=tdengine
TDENGINE_PORT=6030
TDENGINE_USER=root
TDENGINE_PASSWORD=quantpass
TDENGINE_DATABASE=quantbull
TDENGINE_REST_PORT=6041
TDENGINE_REST_PATH=/rest/sql
TDENGINE_REST_SCHEME=http
TDENGINE_REST_TIMEOUT=10.0

# 兼容：quant-engine 旧版/示例 .env 使用小写键（Pydantic 不区分大小写）
tdengine_host=tdengine
tdengine_port=6030
tdengine_user=root
tdengine_password=quantpass
tdengine_database=quantbull
tdengine_rest_port=6041
tdengine_rest_path=/rest/sql
tdengine_rest_scheme=http
tdengine_rest_timeout=10.0

redis_host=redis
redis_port=6379
redis_db=0
redis_password=

# Services
DATA_SERVICE_URL=http://data-service:8001
USER_SERVICE_URL=http://user-service:8005

# Tushare
TUSHARE_TOKEN=ced0595b8c1603011a2fd4bee5e8cca551ce661fdf779a7bda47e66c


# Database
DATABASE_URL=postgresql+asyncpg://quantbull:change_me@postgres:5432/quantbull_db
SYNC_DATABASE_URL=postgresql+psycopg2://quantbull:change_me@postgres:5432/quantbull_db

# --- Cookie/CSRF（生产强制 HTTPS） ---
AUTH_COOKIE_NAME=quantbull_access
CSRF_COOKIE_NAME=quantbull_csrf
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=app.example.com

LOG_LEVEL=INFO

# AI Hub (ai-hub service)
# Note: API keys are shared above (DEEPSEEK_API_KEY / QWEN_API_KEY).
AI_HUB_ENV=local
AI_HUB_HOST=0.0.0.0
AI_HUB_PORT=8002

DEEPSEEK_API_KEY=sk-d0a22a6a95534cb4b168e2e8e020d1fd
QWEN_API_KEY=sk-d0a22a6a95534cb4b168e2e8e020d1fd
OPENAI_API_KEY=sk-d0a22a6a95534cb4b168e2e8e020d1fd

# DeepSeek
DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_MODEL=deepseek-v3.2
DEEPSEEK_MAX_CONCURRENCY=5
DEEPSEEK_RPM=60

# Qwen
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_MAX_CONCURRENCY=3
QWEN_RPM=60

# Routing defaults
DEFAULT_MODEL=deepseek
DEFAULT_MODEL_FOR_NEWS=deepseek
DEFAULT_MODEL_FOR_SUMMARY=qwen
DEFAULT_MODEL_FOR_STRATEGY=deepseek

# Generation defaults
MAX_TOKENS=4096
TEMPERATURE=0.7
REQUEST_TIMEOUT=60

# Digital human placeholder
DIGITAL_HUMAN_API_URL=
DIGITAL_HUMAN_API_KEY=

VIDEO_MAX_SIZE_MB=500
VIDEO_COVER_MAX_SIZE_MB=20