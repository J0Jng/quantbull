# Copy to .env and edit for your environment
# Postgres
POSTGRES_USER=quant
POSTGRES_PASSWORD=quantpass
POSTGRES_DB=quantbull_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Daily Report (schema/user)
DAILY_REPORT_DB_PASSWORD=change_me_daily_report

# SQLAlchemy / SQLModel DATABASE_URL
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://quantbull:quantpass@postgres:5432/quantbull_db

# Tushare API Token (获取地址: https://tushare.pro/)
# 请将下面的 your_tushare_token_here 替换为你的真实 token
TUSHARE_TOKEN=ced0595b8c1603011a2fd4bee5e8cca551ce661fdf779a7bda47e66c
